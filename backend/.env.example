# Both current upstreams (SL Transport and SL Deviations) are keyless public APIs.
# No API key is required to run this backend. This file intentionally has no secret
# variables today. It exists so that:
#  - local dev / Vercel config has one documented place for runtime env vars
#  - a future keyed upstream (or a shared cache backend, see docs/api-contract.md)
#  - has an obvious place to be added without guessing the variable name.

# Port used only by the local Node dev server (src/server.ts). Ignored on Vercel.
PORT=8787

# "development" | "production" | "test"
NODE_ENV=development

# Overridable upstream base URLs (defaults match the documented production endpoints).
# SL_TRANSPORT_BASE_URL=https://transport.integration.sl.se/v1
# SL_DEVIATIONS_BASE_URL=https://deviations.integration.sl.se/v1

# How long (ms) to wait for an upstream response before aborting and returning
# UPSTREAM_TIMEOUT (504). Default: 10000 (10s). See src/lib/upstreamFetch.ts.
# UPSTREAM_TIMEOUT_MS=10000
