{
  "name": "blick-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend proxy and normalization layer for Blick, a commute departure notification app. Talks to SL Transport and SL Deviations, never to Android/iOS clients' storage.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:billing": "tsx scripts/migrateBilling.ts",
    "verify:gtfs-bridge": "tsx scripts/verifyGtfsStopIdentityBridge.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.1",
    "google-auth-library": "^10.3.0",
    "hono": "^4.6.14",
    "postgres": "^3.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.0.12",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
