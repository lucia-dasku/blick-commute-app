<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Deliberately minimal permission set for the MVP (see docs/api-contract.md §16
        of the project documentation and the "Privacy and security" principle):
        no GPS/location, no accounts, no advertising ID.
        POST_NOTIFICATIONS is required on API 33+ to show the commute notification; the
        production runtime-permission flow (see ui/notification/NotificationPermissionFlow.kt)
        requests it at routine-enable/save time, gated behind
        AppSettingsDataStore.hasSeenNotificationRationale so the user is never re-prompted
        after an explicit denial. FOREGROUND_SERVICE and FOREGROUND_SERVICE_DATA_SYNC are
        required for RoutineActiveWindowWorker's active-window foreground execution (see
        scheduling/RoutineActiveWindowWorker.kt and its `dataSync` service-type declaration
        below) — no other foreground-service type applies to "sync fresh departure data from
        the Blick backend while a routine's active window is open." No explicit
        RECEIVE_BOOT_COMPLETED declaration is needed here — WorkManager's own library manifest
        already contributes it (merged automatically) for its own bundled boot receiver, which
        re-establishes its persisted work's system-level scheduling after a reboot on its own;
        see scheduling/NotificationRecoveryCoordinator.kt's own `onAppStart` doc for why a
        separate Blick-specific boot receiver was removed as redundant with, and unsafe
        alongside, that path. POST_PROMOTED_NOTIFICATIONS (Android 16+) is a normal, non-runtime
        permission that
        requests the ongoing routine notification be promoted to a prominent lock-screen Live
        Update / Now Bar surface (see RoutineNotificationBuilder.kt) — declaring it does not
        guarantee promotion (the OS and OEM still decide), so this always coexists with a
        graceful plain-ongoing-notification fallback. No location, camera, microphone, or
        exact-alarm permission is requested anywhere in this app.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".BlickApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blick">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Blick">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            BlickApplication implements Configuration.Provider to hand WorkManager a
            HiltWorkerFactory (see BlickApplication.kt's class doc) — this disables
            WorkManager's own default on-demand `androidx.startup` initializer, which would
            otherwise initialize WorkManager with the default configuration before
            BlickApplication.onCreate ever runs and crash with "WorkManager is already
            initialized" the moment on-demand initialization is triggered here instead.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Declares the `dataSync` foreground-service type for WorkManager's own
            SystemForegroundService, required on API 34+ for RoutineActiveWindowWorker's
            setForeground() call to succeed (see developer.android.com/develop/background-work/
            services/fgs/service-types) — the manifest merger tool combines this declaration
            with the one WorkManager's own library manifest already provides for that service.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
            See notification/StopRoutineNotificationReceiver.kt's own doc — only ever triggered
            by this app's own explicit PendingIntent from the ongoing notification's Stop action,
            never a system or cross-app broadcast, so exported="false" (contrast a receiver for a
            genuine protected system broadcast, which must be exported to receive it at all).
        -->
        <receiver
            android:name=".notification.StopRoutineNotificationReceiver"
            android:exported="false"
            android:enabled="true" />

        <!--
            exported="false" — verified safe, correcting an earlier assumption here that
            exported="true" was required. android.appwidget.action.APPWIDGET_UPDATE is NOT on
            the platform's protected-broadcast allowlist (checked directly against AOSP's
            frameworks/base core/res/AndroidManifest.xml: APPWIDGET_UPDATE_OPTIONS/DELETED/
            DISABLED/ENABLED/HOST_RESTORED/RESTORED/ENABLE_AND_UPDATE are all listed there,
            APPWIDGET_UPDATE itself is not) — but AppWidgetServiceImpl (frameworks/base
            services/appwidget) always delivers it via intent.setComponent(providerComponent)
            before sendBroadcastAsUser, i.e. an EXPLICIT broadcast naming this exact receiver,
            sent from system_server. The platform's exported check gates whether OTHER
            (non-system) apps can target a component; it does not block the system's own
            explicitly-addressed delivery to an app's own component, exported or not — the
            same reasoning notification/StopRoutineNotificationReceiver.kt's own doc already
            applies to this app's own explicit PendingIntents. The widget picker/launcher never
            needs direct visibility into this receiver either: AppWidgetManager.getInstalledProviders()
            is a Binder call into system_server, which does its own PackageManager lookup with
            full (not exported-gated) visibility and returns the result — launchers never query
            this receiver directly. android:updatePeriodMillis is set to 0 in
            res/xml/blick_routine_widget_info.xml specifically so Android's own widget-update
            scheduler is never used — every update is pushed by RoutineWidgetUpdater instead.
        -->
        <receiver
            android:name=".widget.BlickRoutineWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label_standard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blick_routine_widget_info" />
        </receiver>

        <!-- Two sibling widget-picker entries for the same BlickRoutineWidget, differing only
             in declared size/preview — see BlickRoutineWidgetReceiverCompact/Large's own doc
             in BlickRoutineWidget.kt and res/xml/blick_routine_widget_info_compact.xml/
             _large.xml for why this is safe (same GlanceAppWidget class, no update-logic
             change needed) and why android:exported="false" is still correct here (the same
             reasoning as the standard receiver's own comment above: the widget picker
             discovers providers via a system_server Binder call, never direct component
             visibility). android:label on all three (see this receiver and the standard one
             above) gives each its own distinct picker card title — the picker's per-size title
             comes from the RECEIVER's own resolved label, not from anything in the
             appwidget-provider XML, so without it every entry fell back to the same
             application-default "Blick" label. -->
        <receiver
            android:name=".widget.BlickRoutineWidgetReceiverCompact"
            android:exported="false"
            android:label="@string/widget_label_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blick_routine_widget_info_compact" />
        </receiver>

        <receiver
            android:name=".widget.BlickRoutineWidgetReceiverLarge"
            android:exported="false"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blick_routine_widget_info_large" />
        </receiver>
    </application>
</manifest>
