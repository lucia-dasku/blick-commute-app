         vice versa) — see AboutScreen.kt's own LanguageSection doc. Deliberately NOT overridden
         in values-sv/strings.xml: both must stay identical in every locale. -->
    <string name="settings_language_label">Language</string>
    <string name="settings_language_option_english" translatable="false">English</string>
    <string name="settings_language_option_swedish" translatable="false">Svenska</string>
