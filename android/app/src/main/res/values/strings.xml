    <!-- The only hint the notification itself ever gives that a disruption exists — its own
         real header/details are never rendered here at all, in either the collapsed or the
         "expanded" body; see RoutineNotificationBuilder's own doc on why (promoted-ongoing
         notifications have no reliable collapse state to hide the real text behind). %1$s is
         one of the notification_disruption_effect_* labels below, chosen by
         classifyDisruptionEffect on the backend (see docs/api-contract.md, "Disruption effect
         classification") — e.g. "⚠️ Delays · Tap for details". "Tap for details" means what it
         says: tapping opens Routine Details, which shows the real message in full. -->
    <string name="notification_disruption_format">⚠️ %1$s · Tap for details</string>
    <!-- LINE_RELEVANT presentation (see se.blick.app.domain.model.DisruptionRelevance): SL's own
         structured line/mode scope matched PRIMARY, but the affected segment/stop could not be
         proven to intersect this exact journey — so the notification deliberately never claims a
         specific effect (e.g. "No service") is definitely true here, showing only which line is
         implicated instead. %1$s is a single matched PRIMARY line designation (e.g. "11").
         Combined with notification_disruption_format exactly like an effect label would be (see
         RoutineNotificationBuilder's own lineRelevantDisruptionLabel). -->
    <string name="notification_disruption_line_relevant_single_format">Line %1$s disruption</string>
    <!-- Fallback when several PRIMARY lines each have their own LINE_RELEVANT disruption —
         deliberately generic rather than concatenating a cluttered list of line designations. -->
    <string name="notification_disruption_line_relevant_generic">Line disruption</string>
    <!-- One label per backend DisruptionEffect value (see
         se.blick.app.domain.model.DisruptionEffect) — notification_disruption_effect_disruption
         is also the safe fallback label for a disruption whose effect could not be classified or
         is unrecognized by this build (see DisruptionEffect.DISRUPTION's own doc), not only for
         the backend's own literal "DISRUPTION" value. -->
    <string name="notification_disruption_effect_delays">Delays</string>
    <string name="notification_disruption_effect_no_service">No service</string>
    <string name="notification_disruption_effect_reduced_service">Reduced service</string>
    <string name="notification_disruption_effect_route_change">Route change</string>
    <string name="notification_disruption_effect_stop_change">Stop change</string>
    <string name="notification_disruption_effect_replacement_service">Replacement service</string>
    <string name="notification_disruption_effect_station_access">Station access</string>
    <string name="notification_disruption_effect_accessibility_issue">Accessibility issue</string>
    <string name="notification_disruption_effect_disruption">Disruption</string>
    <!-- The ongoing/promoted notification's Stop action (see RoutineNotificationBuilder,
         StopRoutineNotificationReceiver) — stops today's active window early, same effect
         as "pause for today" on the routine details screen. -->
    <string name="notification_action_stop">Stop</string>

    <!-- Home-screen widget (widget/BlickRoutineWidget.kt) — shown outside any active routine
         window. Most other widget state text reuses the notification_*/routine_details_departure_*
         strings above verbatim, the same copy for the same states. -->
    <string name="widget_no_active_commute">No active commute</string>
    <string name="widget_description">Shows your commute\'s next departures while its active window is open.</string>
    <!-- android:label on each of the three widget-picker <receiver> entries in
         AndroidManifest.xml (see BlickRoutineWidgetReceiver/Compact/Large in
         widget/BlickRoutineWidget.kt) — the platform widget picker's own per-size card title
         comes from the RECEIVER component's resolved label, not from anything in the
         appwidget-provider XML resource, so without these all three previously showed the
         same "Blick" application-default label with nothing distinguishing the three sizes. -->
    <string name="widget_label_compact">Blick Small</string>
    <string name="widget_label_standard">Blick Standard</string>
    <string name="widget_label_large">Blick Large</string>
    <!-- Shown instead of notification_loading when the active window is open but notifications
         are unavailable (see RoutineWidgetContent.NotificationsUnavailable's own doc) — the
         widget's only data source cannot run, so it says so rather than staying on "Updating
         departures…" indefinitely. -->
    <string name="widget_notifications_unavailable">Turn on notifications to see live departures here.</string>
    <!-- "Design 1" layout: the big next-departure countdown ("6 min"), and the smaller
         following-departure line, which is its own combined label+countdown string rather than
         two resources concatenated at render time ("Next in 16 min"). -->
    <string name="widget_countdown_minutes_format">%1$d min</string>
    <string name="widget_next_departure_format">Next in %1$d min</string>
    <!-- Direct/Both/With-changes layout: the "Next"/"Alternative" row label, paired with a plain
         widget_countdown_minutes_format value in a two-column row — see BlickRoutineWidget.kt's
         own JourneyMainContent doc. Distinct from journey_next/journey_alternative (ALL CAPS card
         labels used elsewhere) to match this widget's own Title Case convention. -->
    <string name="widget_journey_next_label">Next in</string>
    <string name="widget_journey_alternative_label">Alternative</string>
    <!-- Both/With-changes layout only: the primary journey's own arrival time plus its change
         count — shown instead of "Direct" whenever the journey actually has one or more
         changes. -->
    <plurals name="widget_journey_arrive_with_changes">
        <item quantity="one">Arrive %1$s • %2$d change</item>
        <item quantity="other">Arrive %1$s • %2$d changes</item>
    </plurals>
    <plurals name="widget_journey_changes">
        <item quantity="one">%1$d change</item>
        <item quantity="other">%1$d changes</item>
    </plurals>
    <string name="widget_journey_depart_label">Depart</string>
    <string name="widget_journey_arrive_label">Arrive</string>
    <!-- A short, always-visible header marker for RoutineWidgetContent.Stale — shown
         regardless of compact/full layout or whether any stale departure is still upcoming, see
         StaleIndicator's own doc for why this is the one guaranteed place a stale-data warning
         renders. Deliberately short: this sits inline in the header row next to the line badge
         and destination, not a full sentence. -->
    <string name="widget_stale_indicator">Stale</string>
</resources>
