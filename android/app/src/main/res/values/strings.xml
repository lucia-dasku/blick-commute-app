    <string name="widget_description">Shows your commute\'s next departures while its active window is open.</string>
    <!-- Shown instead of notification_loading when the active window is open but notifications
         are unavailable (see RoutineWidgetContent.NotificationsUnavailable's own doc) — the
         widget's only data source cannot run, so it says so rather than staying on "Updating
         departures…" indefinitely. -->
    <string name="widget_notifications_unavailable">Turn on notifications to see live departures here.</string>
