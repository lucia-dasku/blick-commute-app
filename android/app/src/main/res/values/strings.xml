         with no countdown, and takes priority over the real-time/scheduled row format even
         for a departure that is otherwise real-time. -->
    <string name="notification_row_format">%1$d min • %2$s • %3$s → %4$s</string>
    <string name="notification_row_cancelled_format">%1$s • %2$s → %3$s</string>
    <string name="notification_loading">Updating departures…</string>
