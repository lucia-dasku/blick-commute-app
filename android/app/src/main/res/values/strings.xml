    <!-- Ongoing commute notification (RoutineNotificationBuilder). A quiet, low-importance
         channel — see that class's doc comment for why IMPORTANCE_LOW is used. -->
    <string name="notification_channel_name">Commute departures</string>
    <string name="notification_channel_description">Ongoing departure updates for your active commute routine</string>
    <!-- Title: pinned line + station + destination, all in one line (the system renders the
         title bold by default — no custom styling is applied). Line/destination each fall
         back to the wording below when the routine did not pin a specific value. -->
    <string name="notification_title_format">%1$s · %2$s → %3$s</string>
    <string name="notification_line_fallback">All lines</string>
    <string name="notification_direction_fallback">Any direction</string>
    <!-- Collapsed/expanded body: the next departure's own countdown + status, e.g. "3 min ·
         Live". A cancelled next departure shows routine_details_departure_cancelled alone
         instead, with no countdown. -->
    <string name="notification_departure_status_format">%1$d min · %2$s</string>
    <!-- The following departure's own countdown, shown only when a second departure exists —
         e.g. "Next 18 min". A cancelled following departure shows
         notification_next_departure_cancelled instead. -->
    <string name="notification_next_departure_format">Next in %1$d min</string>
    <string name="notification_next_departure_cancelled">Next · Cancelled</string>
    <string name="notification_loading">Updating departures…</string>
    <string name="notification_last_checked_format">Last checked %1$s</string>
    <!-- Deliberately generic, same rationale as the routine details screen's own error strings:
         never interpolate the raw exception/hostname/class name here. -->
    <string name="notification_offline">Couldn\'t reach the server. Can\'t update your departures right now.</string>
    <string name="notification_unavailable">Couldn\'t load departures right now. Will try again soon.</string>
    <string name="notification_no_departures">No upcoming departures right now.</string>
    <string name="notification_stale_warning">Couldn\'t refresh — showing the last departures we could load.</string>
    <!-- The only hint the notification itself ever gives that a disruption exists — its own
         real header/details are never rendered here at all, in either the collapsed or the
         "expanded" body; see RoutineNotificationBuilder's own doc on why (promoted-ongoing
         notifications have no reliable collapse state to hide the real text behind). %1$s is
         one of the notification_disruption_effect_* labels below, chosen by
         classifyDisruptionEffect on the backend (see docs/api-contract.md, "Disruption effect
         classification") — e.g. "⚠️ Delays · Tap for details". "Tap for details" means what it
         says: tapping opens Routine Details, which shows the real message in full. -->
    <string name="notification_disruption_format">⚠️ %1$s · Tap for details</string>
    <!-- One label per backend DisruptionEffect value (see
         se.blick.app.domain.model.DisruptionEffect) — notification_disruption_effect_disruption
         is also the safe fallback label for a disruption whose effect could not be classified or
         is unrecognized by this build (see DisruptionEffect.DISRUPTION's own doc), not only for
         the backend's own literal "DISRUPTION" value. -->
    <string name="notification_disruption_effect_delays">Delays</string>
    <string name="notification_disruption_effect_no_service">No service</string>
    <string name="notification_disruption_effect_reduced_service">Reduced service</string>
    <string name="notification_disruption_effect_route_change">Route change</string>
    <string name="notification_disruption_effect_stop_change">Stop change</string>
    <string name="notification_disruption_effect_replacement_service">Replacement service</string>
    <string name="notification_disruption_effect_station_access">Station access</string>
    <string name="notification_disruption_effect_accessibility_issue">Accessibility issue</string>
    <string name="notification_disruption_effect_disruption">Disruption</string>
    <!-- The ongoing/promoted notification's Stop action (see RoutineNotificationBuilder,
         StopRoutineNotificationReceiver) — stops today's active window early, same effect
         as "pause for today" on the routine details screen. -->
    <string name="notification_action_stop">Stop</string>

