    <!-- Home-screen widget (widget/BlickRoutineWidget.kt) — shown outside any active routine
         window. Most other widget state text reuses the notification_*/routine_details_departure_*
         strings above verbatim, the same copy for the same states. -->
    <string name="widget_no_active_commute">No active commute.</string>
    <string name="widget_description">Shows your commute\'s next departures while its active window is open.</string>
    <!-- android:label on each of the three widget-picker <receiver> entries in
         AndroidManifest.xml (see BlickRoutineWidgetReceiver/Compact/Large in
         widget/BlickRoutineWidget.kt) — the platform widget picker's own per-size card title
         comes from the RECEIVER component's resolved label, not from anything in the
         appwidget-provider XML resource, so without these all three previously showed the
         same "Blick" application-default label with nothing distinguishing the three sizes. -->
    <string name="widget_label_compact">Blick Compact</string>
    <string name="widget_label_standard">Blick Standard</string>
    <string name="widget_label_large">Blick Large</string>
    <!-- Shown instead of notification_loading when the active window is open but notifications
         are unavailable (see RoutineWidgetContent.NotificationsUnavailable's own doc) — the
         widget's only data source cannot run, so it says so rather than staying on "Updating
         departures…" indefinitely. -->
    <string name="widget_notifications_unavailable">Turn on notifications to see live departures here.</string>
    <!-- "Design 1" layout: the big next-departure countdown ("6 min"), and the smaller
         following-departure line, which is its own combined label+countdown string rather than
         two resources concatenated at render time ("Next in 16 min"). -->
    <string name="widget_countdown_minutes_format">%1$d min</string>
    <string name="widget_next_departure_format">Next in %1$d min</string>
    <!-- A short, always-visible header marker for RoutineWidgetContent.Stale — shown
         regardless of compact/full layout or whether any stale departure is still upcoming, see
         StaleIndicator's own doc for why this is the one guaranteed place a stale-data warning
         renders. Deliberately short: this sits inline in the header row next to the line badge
         and destination, not a full sentence. -->
    <string name="widget_stale_indicator">Stale</string>
</resources>
