<?xml version="1.0" encoding="utf-8"?>
<!--
    android:previewLayout target for blick_routine_widget_info.xml (the default/standard
    provider, sizing left unchanged from the existing shipped file: minWidth=180dp
    minHeight=90dp). That floor sits below BlickRoutineWidget.kt's own isCompactLayout
    thresholds (width<220dp or height<110dp) — a 180dp-wide placement is ALWAYS compact
    regardless of height, since either condition alone is enough — so this preview shows the
    same compact rendering (header + big countdown only) the real widget guarantees at this
    size, just in a slightly larger card than the dedicated "compact" tier
    (blick_routine_widget_info_compact.xml). Only the "large" tier's own preview
    (widget_preview_large.xml) is sized to guarantee the fuller layout — see that file's own
    doc.
-->
<!-- tools:ignore="HardcodedText" — see widget_preview_compact.xml's own comment; same
     deliberately static, non-localized preview-only content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="11dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_line_badge"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="14"
            android:textColor="@color/widget_preview_line_badge_text"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Fruängen → T-Centralen"
            android:textColor="@color/widget_preview_on_background"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="4 min"
        android:textColor="@color/widget_preview_on_background"
        android:textStyle="bold"
        android:textSize="26sp" />
</LinearLayout>
