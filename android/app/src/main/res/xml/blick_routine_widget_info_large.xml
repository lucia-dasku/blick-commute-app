<?xml version="1.0" encoding="utf-8"?>
<!-- Canonical 4x4 Large entry. Its bounds guarantee the Large tier with route wrapping,
     journey times, Next, and the optional bottom disruption area. updatePeriodMillis remains
     zero so this larger presentation does not introduce any independent refresh mechanism. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="300dp"
    android:minHeight="220dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="300dp"
    android:minResizeHeight="220dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="360dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_large"
    android:previewImage="@drawable/widget_preview_large"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
