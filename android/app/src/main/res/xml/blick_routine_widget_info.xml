<?xml version="1.0" encoding="utf-8"?>
<!-- Canonical 3x2 Standard entry. SizeMode.Exact lets the shared renderer use the bounds a
     launcher actually reports while these min/max values keep this provider in the Standard
     tier. updatePeriodMillis="0" is deliberate: Android never starts an additional widget
     schedule; RoutineWidgetUpdater remains the only writer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="220dp"
    android:minHeight="120dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="220dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="299dp"
    android:maxResizeHeight="219dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_standard"
    android:previewImage="@drawable/widget_preview_standard"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
